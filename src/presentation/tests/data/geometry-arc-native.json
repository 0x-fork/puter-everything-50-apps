  "observations": {
    "angles": "Nondegenerate ellipses use radial angles, converted to ellipse parameters with signed radii. A single negative radius reverses physical sweep orientation.",
    "sweep": "Zero sweep draws no arc. Sweeps of positive/negative 450 and 720 degrees clamp to one signed full turn.",
    "degenerate": "With either radius zero, native uses unskewed parameter angles and draws along the remaining axis, including its extrema. Both radii zero leave the pen unchanged."
  },
  "interoperability": {
    "controls": "All three generated eight-control PPTX packages have byte-identical parts to their pre-fix native controls.",
    "slideTransfer": "Full-slide forward and return exports opened without repair; both complete native printed pages are pixel-identical to the native original.",
    "objectClipboard": "Actual application three-object forward and return downloads opened without repair. Native printed path commands equal the original first three paths, and on return the original eight plus the returned three.",
    "textEdit": "The application text-edit download opened without repair. Native print contains Native radial arc and all eight original path command arrays remain unchanged.",
    "authoredGeometry": "Save, edit and both transfer directions retain DrawingML arcTo commands and their authored values; evaluated SVG segments are not materialized into the package."
  },
