{
  "name": "help-desk",
  "version": "0.1.0",
  "description": "Help Desk: shared inbox, tickets, customers, help center and reports, stored in your own Puter cloud.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:worker && vite",
    "build": "npm run check:licenses && npm run build:worker && vite build",
    "build:worker": "vite build --config vite.worker.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:licenses": "node tools/check-licenses.mjs"
  },
  "dependencies": {
    "lucide": "1.55.0"
  },
  "devDependencies": {
    "axe-core": "4.10.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
